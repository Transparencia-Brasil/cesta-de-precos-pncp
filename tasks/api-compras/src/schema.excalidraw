      "startArrowhead": null,
      "endArrowhead": "arrow",
      "elbowed": false
    },
    {
      "id": "9K-8oMHJ_fjwobqpnzphd",
      "type": "text",
      "x": 618.256011201066,
      "y": 2861.8380596716543,
      "width": 725.2065343351651,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2z",
      "roundness": null,
      "seed": 307465265,
      "version": 962,
      "versionNonce": 1381649399,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782410096523,
      "link": null,
      "locked": false,
      "text": "Aqui será feita mais uma chamada no Compras, dessa vez coletando o\nCampo de marca.\n\nIMPORTANTE:\n- A combertura dos dados não é completa: haverá itens do compras sem\ndado de marca.\n- Os dados não são padronizados: há inconsistência no preenchimento do\ncampo `marca` e não é possível agrupar esses dados a priori.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aqui será feita mais uma chamada no Compras, dessa vez coletando o Campo de marca.\n\nIMPORTANTE:\n- A combertura dos dados não é completa: haverá itens do compras sem dado de marca.\n- Os dados não são padronizados: há inconsistência no preenchimento do campo `marca` e não é possível agrupar esses dados a priori.",
      "autoResize": false,
      "lineHeight": 1.25
    },
